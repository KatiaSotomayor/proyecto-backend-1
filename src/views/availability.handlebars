<section class="portada">
    <p class="sobretitulo">Disponibilidad</p>
    <h1>{{title}}</h1>
    <p class="texto-suave">Qué se puede reservar hoy y qué está fuera de servicio.</p>
</section>

<section>
    <h2 class="titulo-seccion disponible">Disponibles ({{availableServices.length}})</h2>
    {{#if availableServices.length}}
    <ul class="lista">
        {{#each availableServices}}
        <li>
            <strong>{{name}}</strong>
            <span class="texto-suave">{{category}} · {{duration}} min</span>
            <span class="precio">${{price}}</span>
        </li>
        {{/each}}
    </ul>
    {{else}}
    <p class="vacio">No hay servicios disponibles.</p>
    {{/if}}
</section>

<section>
    <h2 class="titulo-seccion no-disponible">No disponibles ({{unavailableServices.length}})</h2>
    {{#if unavailableServices.length}}
    <ul class="lista">
        {{#each unavailableServices}}
        <li class="no-disponible">
            <strong>{{name}}</strong>
            <span class="texto-suave">{{category}} · {{duration}} min</span>
            <span class="precio">${{price}}</span>
        </li>
        {{/each}}
    </ul>
    {{else}}
    <p class="vacio">Todos los servicios están disponibles.</p>
    {{/if}}
</section>